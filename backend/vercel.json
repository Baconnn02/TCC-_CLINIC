{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.php",
      "use": "vercel-php@0.6.2"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.php"
    },
    {
      "src": "/up",
      "dest": "/backend/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}

